# Copy this file to ".env" and edit values. Every line is optional.
# Real environment variables override values in .env.

# --- Web server ---
AYURBOT_HOST=127.0.0.1
AYURBOT_PORT=7860
# If the port is busy, AyurBot tries the next N ports.
AYURBOT_PORT_SEARCH_RANGE=10
AYURBOT_OPEN_BROWSER=false

# --- Knowledge base (relative paths are relative to the project folder) ---
AYURBOT_KB_PATH=data/herbs.json

# --- Semantic search model ---
AYURBOT_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# true = never load the transformer; use lexical (BM25) search only.
AYURBOT_DISABLE_TRANSFORMER=false
# true = never use the internet; load the model from the local cache only.
AYURBOT_OFFLINE=false
# Optional: keep the model inside the project, e.g. models
AYURBOT_MODEL_CACHE_DIR=
# cpu (default) or auto (use an NVIDIA GPU if available)
AYURBOT_DEVICE=cpu

# --- Retrieval tuning ---
AYURBOT_TOP_K=3
AYURBOT_MIN_SEMANTIC_SCORE=0.30
AYURBOT_MIN_LEXICAL_SCORE=0.25

# --- Limits ---
AYURBOT_MAX_QUERY_CHARS=1000
AYURBOT_MAX_HISTORY_MESSAGES=40
AYURBOT_CONCURRENCY_LIMIT=4
